# Stop a recipe on a failed command, an unset variable or a failed pipe
set shell := ["bash", "-euo", "pipefail", "-c"]

nargo := env("NARGO", "nargo")
bb := env("BB", "bb")
ortools_version := "9.15.6755"

# The OR-Tools C++ library that the solver links, which `just crates-tooling` installs
export ORTOOLS_PREFIX := env("ORTOOLS_PREFIX", home_directory() / ".ortools" / ("v" + ortools_version))

# The protobuf compiler for the build of `cp_sat`; the OR-Tools archive has one
export PROTOC := env("PROTOC", ORTOOLS_PREFIX / "bin" / "protoc")

# Default recipe
default:
    @just --list

# --- All components ---

# Run every check that CI runs
all-check: contracts-check circuits-check crates-check

# --- Contracts ---

# Install contract dependencies
contracts-deps:
    cd contracts && forge soldeer install

# Install the contract tooling from the lockfile
contracts-tooling:
    cd contracts && bun install --frozen-lockfile

# Clean contracts
contracts-clean:
    cd contracts && forge clean

# Build contracts
contracts-build *args:
    cd contracts && forge build {{ args }}

# Run contract tests
contracts-test *args:
    cd contracts && forge test --force {{ args }}

# Lint contracts: forge lint, then solhint for the rules that forge lint lacks
contracts-lint:
    cd contracts && forge lint --deny notes
    cd contracts && bunx --bun solhint --config .solhint.json 'src/**/*.sol'
    cd contracts && bunx --bun solhint --config .solhint.other.json 'test/**/*.sol'

# Run slither on contracts
contracts-static-analysis:
    cd contracts && slither .
    @echo "Removing slither compilation artifacts..."
    cd contracts && forge clean

# Format contracts
contracts-fmt *args:
    cd contracts && forge fmt {{ args }}

# Check contract formatting
contracts-fmt-check:
    cd contracts && forge fmt --check

# Regenerate the Rust bindings of the contracts
contracts-gen-bindings:
    # `forge bind` builds without bytecode, so it reads the artifacts of this build.
    cd contracts && forge clean && forge build src/AnomaVerifier.sol src/interfaces/IAnomaVerifier.sol \
        && forge bind --skip-build --select '^(AnomaVerifier|IAnomaVerifier)$' \
        --bindings-path ../crates/bindings/src/generated/ --module --overwrite

# Check that the Rust bindings match the contracts
bindings-check: contracts-gen-bindings
    git diff --exit-code -- crates/bindings/src/generated/

# Run every contract check that CI runs
contracts-check: contracts-fmt-check contracts-lint contracts-static-analysis contracts-test

# --- Circuits ---

# Compile all circuits
circuits-build:
    cd circuits && {{ nargo }} compile --workspace

# Run the circuit tests
circuits-test:
    cd circuits && {{ nargo }} test --workspace

# Format circuits
circuits-fmt:
    cd circuits && {{ nargo }} fmt

# Check circuit formatting
circuits-fmt-check:
    cd circuits && {{ nargo }} fmt --check

# Write the key hashes that the root circuit checks, then compile the root circuit with them
circuits-keys: circuits-build
    #!/usr/bin/env bash
    set -euo pipefail
    cd circuits
    key_hash() {
        if ! log=$({{ bb }} write_vk -b "target/$1.json" -o "target/$1-vk" -t noir-recursive-no-zk 2>&1); then
            echo "$log" >&2
            exit 1
        fi
        echo "0x$(xxd -p -c 32 "target/$1-vk/vk_hash")"
    }
    {
        echo "// Generated by \`just circuits-keys\`."
        echo "pub global COMPLIANCE_KEY_HASH: Field = $(key_hash compliance);"
        echo "pub global FIRST_STEP_KEY_HASH: Field = $(key_hash first_step);"
        echo "pub global NEXT_STEP_KEY_HASH: Field = $(key_hash next_step);"
    } > crates/root/src/keys.nr
    {{ nargo }} fmt
    {{ nargo }} compile --package root

# Check that the key hashes of the root circuit match the other circuits
circuits-keys-check: circuits-keys
    git diff --exit-code -- circuits/crates/root/src/keys.nr

# Run every circuit check that CI runs
circuits-check: circuits-fmt-check circuits-keys-check circuits-test

# --- Crates ---

# Install the OR-Tools C++ library for arm64 macOS, which the solver links
crates-tooling:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f "$ORTOOLS_PREFIX/include/ortools/sat/cp_model.h" ]; then exit 0; fi
    if [ "$(uname -sm)" != "Darwin arm64" ]; then
        echo "no OR-Tools archive for $(uname -sm); install OR-Tools {{ ortools_version }} and set ORTOOLS_PREFIX" >&2
        exit 1
    fi
    archive="or-tools_arm64_macOS-26.2_cpp_v{{ ortools_version }}.tar.gz"
    download=$(mktemp -d)
    curl -fsSL -o "$download/$archive" "https://github.com/google/or-tools/releases/download/v9.15/$archive"
    echo "de0400a45939a66ee13cd8360c230e830fc5e03a6ed5a8a8b60f58a39e4a67bc  $download/$archive" | shasum -a 256 -c -
    mkdir -p "$ORTOOLS_PREFIX"
    tar -xzf "$download/$archive" -C "$ORTOOLS_PREFIX" --strip-components 1

# Build the crates
crates-build *args:
    cargo build --workspace --all-targets {{ args }}

# Run the crate tests that need no prover
crates-test *args:
    cargo test --workspace {{ args }}

# Run all crate tests, also those that prove transactions and execute them on anvil; one thread, since each proof uses all cores
crates-test-slow *args: circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo test --workspace --all-features {{ args }} -- --test-threads 1

# Print the time of each proof of a wrap, a transfer and an unwrap as a Markdown table
crates-prove-times: circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo bench -p anoma-integration-test --features slow-tests --bench prove_times

# Print the gas of a wrap, a transfer and an unwrap on anvil with the Osaka hardfork as a Markdown table
crates-execution-gas: circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo bench -p anoma-integration-test --features slow-tests --bench execution_gas

# Lint the crates for both feature sets
crates-lint:
    cargo clippy --workspace --all-targets --no-deps -- -Dwarnings
    cargo clippy --workspace --all-targets --all-features --no-deps -- -Dwarnings

# Format the crates
crates-fmt:
    cargo fmt --all

# Check the crate formatting
crates-fmt-check:
    cargo fmt --all -- --check

# Run every crate check that CI runs
crates-check: crates-fmt-check crates-build crates-lint crates-test
