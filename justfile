# Stop a recipe on a failed command, an unset variable or a failed pipe
set shell := ["bash", "-euo", "pipefail", "-c"]

nargo := env("NARGO", "nargo")
bb := env("BB", "bb")
pnpm := env("PNPM", "pnpm")
ortools_version := "9.15.6755"

# The OR-Tools C++ library that the solver links, which `just crates-tooling` installs
export ORTOOLS_PREFIX := env("ORTOOLS_PREFIX", home_directory() / ".ortools" / ("v" + ortools_version))

# The protobuf compiler for the build of `cp_sat`; the OR-Tools archive has one
export PROTOC := env("PROTOC", ORTOOLS_PREFIX / "bin" / "protoc")

# Default recipe
default:
    @just --list

# --- All components ---

# Run every check that CI runs
all-check: contracts-check circuits-check crates-check indexer-check

# --- Contracts ---

# Install contract dependencies
contracts-deps:
    cd contracts && forge soldeer install

# Install the contract tooling from the lockfile
contracts-tooling:
    cd contracts && bun install --frozen-lockfile

# Clean contracts
contracts-clean:
    cd contracts && forge clean

# Build contracts
contracts-build *args:
    cd contracts && forge build {{ args }}

# Run contract tests
contracts-test *args: belt-ffi-build
    cd contracts && forge test --force {{ args }}

# Build the Rust belt that the differential contract tests run
belt-ffi-build:
    cargo build --release -p anoma-belt-ffi

# Lint contracts: forge lint, then solhint for the rules that forge lint lacks
contracts-lint:
    cd contracts && forge lint --deny notes
    cd contracts && bunx --bun solhint --config .solhint.json 'src/**/*.sol'
    cd contracts && bunx --bun solhint --config .solhint.other.json 'test/**/*.sol'

# Run slither on contracts
contracts-static-analysis:
    cd contracts && slither .
    @echo "Removing slither compilation artifacts..."
    cd contracts && forge clean

# Format contracts
contracts-fmt *args:
    cd contracts && forge fmt {{ args }}

# Check contract formatting
contracts-fmt-check:
    cd contracts && forge fmt --check

# Regenerate the Rust bindings of the contracts
contracts-gen-bindings:
    # `forge bind` builds without bytecode, so it reads the artifacts of this build.
    cd contracts && forge clean && forge build src/AnomaVerifier.sol src/interfaces/IAnomaVerifier.sol \
        && forge bind --skip-build --select '^(AnomaVerifier|IAnomaVerifier)$' \
        --bindings-path ../crates/bindings/src/generated/ --module --overwrite

# Check that the Rust bindings match the contracts
bindings-check: contracts-gen-bindings
    git diff --exit-code -- crates/bindings/src/generated/

# Run every contract check that CI runs
contracts-check: contracts-fmt-check contracts-lint contracts-static-analysis contracts-test

# --- Circuits ---

# Compile all circuits
circuits-build:
    cd circuits && {{ nargo }} compile --workspace

# Run the circuit tests
circuits-test:
    cd circuits && {{ nargo }} test --workspace

# Format circuits
circuits-fmt:
    cd circuits && {{ nargo }} fmt

# Check circuit formatting
circuits-fmt-check:
    cd circuits && {{ nargo }} fmt --check

# Write a compliance, a first step and a next step circuit for each size of action, and the workspace that lists them
circuits-variants:
    #!/usr/bin/env bash
    set -euo pipefail
    cd circuits
    max_resources=$(sed -nE 's/^pub global MAX_RESOURCES: u32 = ([0-9]+);$/\1/p' crates/arm/src/action.nr)
    bb_proof_verification='bb_proof_verification = { git = "https://github.com/AztecProtocol/aztec-packages/", tag = "v6.0.0", directory = "barretenberg/noir/bb_proof_verification" }'
    rm -rf variants
    for size in $(seq 1 "$max_resources"); do
        for circuit in compliance first_step next_step; do
            mkdir -p "variants/${circuit}_$size/src"
            {
                echo "# Generated by \`just circuits-variants\`."
                echo "[package]"
                echo "name = \"${circuit}_$size\""
                echo "type = \"bin\""
                echo "authors = [\"Heueristik\"]"
                echo "compiler_version = \">=1.0.0\""
                echo
                echo "[dependencies]"
                if [ "$circuit" = compliance ]; then
                    echo 'compliance = { path = "../../crates/compliance" }'
                else
                    echo "$bb_proof_verification"
                    echo 'step = { path = "../../crates/step" }'
                fi
            } > "variants/${circuit}_$size/Nargo.toml"
        done
        cat > "variants/compliance_$size/src/main.nr" <<EOF
    // Generated by \`just circuits-variants\`.
    use compliance::{check, ComplianceInstance, ComplianceWitness};

    /// Checks a compliance unit of $size resources.
    fn main(instance: pub ComplianceInstance<$size>, witness: ComplianceWitness<$size>) {
        check(instance, witness);
    }
    EOF
        cat > "variants/first_step_$size/src/main.nr" <<EOF
    // Generated by \`just circuits-variants\`.
    use bb_proof_verification::UltraHonkVerificationKey;
    use step::{ActionProofs, CircuitKeys, first_step, StepState};

    /// Starts a transaction with its first action, of $size resources.
    fn main(keys: CircuitKeys, compliance_vk: UltraHonkVerificationKey, action: ActionProofs<$size>) -> pub StepState {
        first_step(keys, compliance_vk, action)
    }
    EOF
        cat > "variants/next_step_$size/src/main.nr" <<EOF
    // Generated by \`just circuits-variants\`.
    use bb_proof_verification::{UltraHonkProof, UltraHonkVerificationKey};
    use step::{ActionProofs, CircuitKeys, next_step, StepCircuit, StepState};

    /// Adds the next action, of $size resources, to the state of the previous step proof.
    fn main(
        previous_vk: UltraHonkVerificationKey,
        previous_proof: UltraHonkProof,
        previous: StepState,
        previous_circuit: StepCircuit,
        keys: CircuitKeys,
        compliance_vk: UltraHonkVerificationKey,
        action: ActionProofs<$size>,
    ) -> pub StepState {
        next_step(previous_vk, previous_proof, previous, previous_circuit, keys, compliance_vk, action)
    }
    EOF
    done
    {
        echo "# Generated by \`just circuits-variants\`."
        echo "[workspace]"
        echo "members = ["
        for member in crates/* $(for size in $(seq 1 "$max_resources"); do echo variants/{compliance,first_step,next_step}_$size; done); do
            echo "    \"$member\","
        done
        echo "]"
    } > Nargo.toml
    {{ nargo }} fmt

# Check that the circuit variants match the generator
circuits-variants-check: circuits-variants
    git diff --exit-code -- circuits/Nargo.toml circuits/variants
    test -z "$(git ls-files --others --exclude-standard -- circuits/variants)"

# Write the key hashes that the root circuit checks, then compile the root circuit with them
circuits-keys: circuits-build
    #!/usr/bin/env bash
    set -euo pipefail
    cd circuits
    key_hash() {
        if ! log=$({{ bb }} write_vk -b "target/$1.json" -o "target/$1-vk" -t noir-recursive-no-zk 2>&1); then
            echo "$log" >&2
            exit 1
        fi
        echo "0x$(xxd -p -c 32 "target/$1-vk/vk_hash")"
    }
    max_resources=$(sed -nE 's/^pub global MAX_RESOURCES: u32 = ([0-9]+);$/\1/p' crates/arm/src/action.nr)
    # Plain assignments, so that a failed key hash stops the recipe.
    for circuit in compliance first_step next_step; do
        hashes=""
        for size in $(seq 1 "$max_resources"); do
            hash=$(key_hash "${circuit}_$size")
            hashes+="$hash, "
        done
        printf -v "${circuit}_hashes" '%s' "$hashes"
    done
    {
        echo "// Generated by \`just circuits-keys\`."
        echo "use step::CircuitKeys;"
        echo
        echo "pub global CIRCUIT_KEYS: CircuitKeys = CircuitKeys {"
        echo "compliance: [$compliance_hashes],"
        echo "first_step: [$first_step_hashes],"
        echo "next_step: [$next_step_hashes],"
        echo "};"
    } > crates/root/src/keys.nr
    {{ nargo }} fmt
    {{ nargo }} compile --package root

# Check that the key hashes of the root circuit match the other circuits
circuits-keys-check: circuits-keys
    git diff --exit-code -- circuits/crates/root/src/keys.nr

# Run every circuit check that CI runs
circuits-check: circuits-fmt-check circuits-variants-check circuits-keys-check circuits-test

# --- Crates ---

# Install the OR-Tools C++ library for arm64 macOS, which the solver links
crates-tooling:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f "$ORTOOLS_PREFIX/include/ortools/sat/cp_model.h" ]; then exit 0; fi
    if [ "$(uname -sm)" != "Darwin arm64" ]; then
        echo "no OR-Tools archive for $(uname -sm); install OR-Tools {{ ortools_version }} and set ORTOOLS_PREFIX" >&2
        exit 1
    fi
    archive="or-tools_arm64_macOS-26.2_cpp_v{{ ortools_version }}.tar.gz"
    download=$(mktemp -d)
    curl -fsSL -o "$download/$archive" "https://github.com/google/or-tools/releases/download/v9.15/$archive"
    echo "de0400a45939a66ee13cd8360c230e830fc5e03a6ed5a8a8b60f58a39e4a67bc  $download/$archive" | shasum -a 256 -c -
    mkdir -p "$ORTOOLS_PREFIX"
    tar -xzf "$download/$archive" -C "$ORTOOLS_PREFIX" --strip-components 1

# Build the crates
crates-build *args:
    cargo build --workspace --all-targets {{ args }}

# Run the crate tests that need no prover
crates-test *args:
    cargo test --workspace {{ args }}

# Run all crate tests, also those that prove transactions and execute them on anvil; one thread, since each proof uses all cores
crates-test-slow *args: circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo test --workspace --all-features {{ args }} -- --test-threads 1

# Print the time of each proof of a wrap, a transfer, an unwrap, a transfer with change and a split into three as a Markdown table
crates-prove-times: circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo bench -p anoma-integration-test --features slow-tests --bench prove_times

# Print the gas of a wrap, a transfer, an unwrap, a transfer with change and a split into three on anvil with the Osaka hardfork as a Markdown table
crates-execution-gas: circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo bench -p anoma-integration-test --features slow-tests --bench execution_gas

# Write the Solidity verifier of the Groth16 wrap for the root circuit; the first run makes the single-party setup, so the verifier is for tests only
crates-groth16-verifier output="target/Groth16Verifier.sol": circuits-keys
    NARGO={{ nargo }} BB={{ bb }} cargo run -p anoma-integration-test --bin groth16_verifier -- target/tmp/wrap-keys "{{ output }}"

# Lint the crates for both feature sets
crates-lint:
    cargo clippy --workspace --all-targets --no-deps -- -Dwarnings
    cargo clippy --workspace --all-targets --all-features --no-deps -- -Dwarnings

# Format the crates
crates-fmt:
    cargo fmt --all

# Check the crate formatting
crates-fmt-check:
    cargo fmt --all -- --check

# Run every crate check that CI runs
crates-check: crates-fmt-check crates-build crates-lint crates-test

# --- Indexer ---

# Install the indexer packages from the lockfile
indexer-deps:
    cd indexer && {{ pnpm }} install --frozen-lockfile

# Generate the indexer types from config.yaml and schema.graphql
indexer-codegen:
    cd indexer && {{ pnpm }} codegen

# Type-check the indexer
indexer-typecheck: indexer-codegen
    cd indexer && {{ pnpm }} typecheck

# Lint the indexer
indexer-lint: indexer-codegen
    cd indexer && {{ pnpm }} lint

# Run the indexer tests
indexer-test: indexer-codegen
    cd indexer && {{ pnpm }} test

# Format the indexer
indexer-fmt:
    cd indexer && {{ pnpm }} format

# Check the indexer formatting
indexer-fmt-check:
    cd indexer && {{ pnpm }} format:check

# Run every indexer check that CI runs
indexer-check: indexer-fmt-check indexer-typecheck indexer-lint indexer-test

# Index the chain of indexer/config.yaml into Postgres and serve it on GraphQL; needs Docker
indexer-dev:
    cd indexer && {{ pnpm }} dev
